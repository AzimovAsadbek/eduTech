# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://edutech.uz
AUTH_SECRET=replace-with-openssl-rand-base64-48
SESSION_TTL_HOURS=12

POSTGRES_USER=edutech
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=edutech

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-openssl-rand-hex-24

UPLOAD_DIR=/app/public/uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_MB=10

SEED_ADMIN_EMAIL=admin@edutech.uz
SEED_ADMIN_PASSWORD=replace-me-strong
SEED_ADMIN_NAME=EduTech Admin
