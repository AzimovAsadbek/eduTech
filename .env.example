# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://edutech:edutech@localhost:5433/edutech?schema=public"

# ── App ──────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -base64 48`
AUTH_SECRET="change-me-to-a-long-random-string-change-me-to-a-long-random-string"
SESSION_TTL_HOURS=12

# ── Initial super admin (used by `npm run db:seed`) ──────
SEED_ADMIN_EMAIL="admin@edutech.uz"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="EduTech Admin"

# ── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Random string; Telegram sends it back as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Override for tests / mocks (default https://api.telegram.org)
TELEGRAM_API_BASE=""

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
UPLOAD_PUBLIC_PATH="/uploads"
UPLOAD_MAX_MB=10

# ── Analytics (optional) ─────────────────────────────────
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"

# ── SEO (optional) ────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""
